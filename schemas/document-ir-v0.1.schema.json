{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kentaro-Ono-jp/Aiteqno/schemas/document-ir-v0.1.schema.json",
  "title": "Aiteqno Document IR v0.1",
  "description": "Renderer- and extractor-independent contract for Aiteqno Document IR v0.1.",
  "$comment": "Cross-object geometry uses a 0.01 pt tolerance and is enforced by the Python semantic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "document_id",
    "generator",
    "pages",
    "assets"
  ],
  "properties": {
    "ir_version": {
      "const": "0.1.0"
    },
    "document_id": {
      "$ref": "#/$defs/identifier"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "metadata": {
      "type": "object"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^#[0-9a-f]{6}$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9][a-z0-9_-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "boundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "positiveBoundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "lineBoundingBox": {
      "allOf": [
        {
          "$ref": "#/$defs/boundingBox"
        },
        {
          "anyOf": [
            {
              "properties": {
                "width": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "height": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        }
      ]
    },
    "pixelBoundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pageSize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "unit"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "const": "pt"
        }
      }
    },
    "pageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pixel_width",
        "pixel_height",
        "dpi_x",
        "dpi_y",
        "dpi_source"
      ],
      "properties": {
        "pixel_width": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_height": {
          "type": "integer",
          "minimum": 1
        },
        "dpi_x": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dpi_y": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dpi_source": {
          "enum": [
            "declared",
            "inferred"
          ]
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall"
      ],
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "detection": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recognition": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "provider",
        "provider_version",
        "source_refs"
      ],
      "properties": {
        "stage": {
          "enum": [
            "manual",
            "structure",
            "ocr",
            "normalize",
            "derived"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "provider_version": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "source_bbox_px": {
          "$ref": "#/$defs/pixelBoundingBox"
        },
        "parameters_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font_family",
        "font_size_pt",
        "font_weight",
        "font_style",
        "color",
        "align",
        "line_height",
        "rotation_deg"
      ],
      "properties": {
        "font_family": {
          "type": "string",
          "minLength": 1
        },
        "font_size_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "font_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "font_style": {
          "enum": [
            "normal",
            "italic",
            "oblique"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        "line_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation_deg": {
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "lineStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_pt",
        "color",
        "dash"
      ],
      "properties": {
        "width_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "dash": {
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "dash-dot"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "rectangleStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stroke_color",
        "stroke_width_pt",
        "fill_color",
        "corner_radius_pt"
      ],
      "properties": {
        "stroke_color": {
          "$ref": "#/$defs/color"
        },
        "stroke_width_pt": {
          "type": "number",
          "minimum": 0
        },
        "fill_color": {
          "$ref": "#/$defs/color"
        },
        "corner_radius_pt": {
          "type": "number",
          "minimum": 0
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "media_type",
        "sha256",
        "pixel_width",
        "pixel_height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/sha256-[0-9a-f]{64}\\.(png|jpg|jpeg)$"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pixel_width": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_height": {
          "type": "integer",
          "minimum": 1
        },
        "dpi_x": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dpi_y": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "textElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "bbox",
        "z_index",
        "confidence",
        "provenance",
        "text",
        "reading_order",
        "style"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "text"
        },
        "bbox": {
          "$ref": "#/$defs/positiveBoundingBox"
        },
        "z_index": {
          "type": "integer"
        },
        "confidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/confidence"
            }
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "text": {
          "type": "string"
        },
        "reading_order": {
          "type": "integer",
          "minimum": 0
        },
        "style": {
          "$ref": "#/$defs/textStyle"
        }
      }
    },
    "lineElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "bbox",
        "z_index",
        "confidence",
        "provenance",
        "start",
        "end",
        "style"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "line"
        },
        "bbox": {
          "$ref": "#/$defs/lineBoundingBox"
        },
        "z_index": {
          "type": "integer"
        },
        "confidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/confidence"
            }
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        },
        "style": {
          "$ref": "#/$defs/lineStyle"
        }
      }
    },
    "rectangleElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "bbox",
        "z_index",
        "confidence",
        "provenance",
        "style"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "rectangle"
        },
        "bbox": {
          "$ref": "#/$defs/positiveBoundingBox"
        },
        "z_index": {
          "type": "integer"
        },
        "confidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/confidence"
            }
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "style": {
          "$ref": "#/$defs/rectangleStyle"
        }
      }
    },
    "imageElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "bbox",
        "z_index",
        "confidence",
        "provenance",
        "asset_id",
        "fit"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "image"
        },
        "bbox": {
          "$ref": "#/$defs/positiveBoundingBox"
        },
        "z_index": {
          "type": "integer"
        },
        "confidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/confidence"
            }
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "asset_id": {
          "$ref": "#/$defs/identifier"
        },
        "fit": {
          "enum": [
            "contain",
            "cover",
            "stretch"
          ]
        },
        "alt_text": {
          "type": "string"
        }
      }
    },
    "element": {
      "oneOf": [
        {
          "$ref": "#/$defs/textElement"
        },
        {
          "$ref": "#/$defs/lineElement"
        },
        {
          "$ref": "#/$defs/rectangleElement"
        },
        {
          "$ref": "#/$defs/imageElement"
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "size",
        "elements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "size": {
          "$ref": "#/$defs/pageSize"
        },
        "source": {
          "$ref": "#/$defs/pageSource"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
